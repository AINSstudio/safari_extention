{
  "manifest_version": 3,
  "name": "AINS Studio Glasswing",
  "version": "5.0.0",
  "description": "Glasswing brings AINS Studio reading tools and appearance controls to Safari.",
  "action": {
    "default_title": "Open AINS Studio settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://ains.moe.gov.my/web/*"],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.4"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://ains.moe.gov.my/web/*"],
      "js": ["browser-compat.js", "theme.js", "bulk-import.js", "studio-dashboard.js"],
      "run_at": "document_start"
    }
  ]
}
